# Create a free account at https://www.emailjs.com, add an Email Service and
# a Template (with fields: name, email, subject, message), then copy the IDs
# below into a local ".env" file (never commit the real .env).
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
